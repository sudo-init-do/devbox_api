APP_ENV=local
PORT=8080

# =====================
# Database
# =====================

# Postgres credentials
POSTGRES_USER=devbox_user
POSTGRES_PASSWORD=devbox_pass
POSTGRES_DB=devbox

# Local (when you run go run on your Mac)
DATABASE_URL_LOCAL=postgres://devbox_user:devbox_pass@localhost:5432/devbox?sslmode=disable

# Docker (when app runs inside docker-compose network)
DATABASE_URL_DOCKER=postgres://devbox_user:devbox_pass@devbox_postgres:5432/devbox?sslmode=disable


# =====================
# Redis
# =====================

# Local (Mac)
REDIS_URL_LOCAL=redis://localhost:6379

# Docker
REDIS_URL_DOCKER=redis://redis:6379
